# Country data is regenerated and re-committed, so line endings must be stable -
# without this, Windows core.autocrlf rewrites every line and a one-event change
# shows up as a whole-file diff.
*.json text eol=lf

# Source and templates, same reasoning.
*.py    text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.j2    text eol=lf
*.md    text eol=lf
*.yml   text eol=lf

# Cloudflare parses _redirects line by line; keep it LF regardless of platform.
tools/subdomain-redirect/_redirects text eol=lf
