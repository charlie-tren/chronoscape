<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% set page_desc = "Interactive timelines of world history - eras, key events, and a map you can click through." %}
<title>Chronoscape - Interactive timelines of world history</title>
<meta name="description" content="{{ page_desc }}">
<link rel="canonical" href="{{ canonical }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Chronoscape">
<meta property="og:title" content="Chronoscape - Interactive timelines of world history">
<meta property="og:description" content="{{ page_desc }}">
<meta property="og:url" content="{{ canonical }}">
<meta name="twitter:card" content="summary">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>&#127963;</text></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="static/style.css">
<!-- Cloudflare Web Analytics. Manual, not edge-injected: the account's Web
     Analytics site is in "JS Snippet installation" mode so that the non-proxied
     hosts (GitHub Pages, Vercel) are counted too, and in that mode Cloudflare
     stops injecting automatically here. Without this tag Chronoscape reports
     nothing. -->
<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "32b821209b5441a08df42ccf61c9e6c2"}'></script>
</head>
<body>

<header class="site-header">
  <div>
    <h1>Chronoscape</h1>
    <p class="tagline">Interactive timelines of world history</p>
  </div>
  <a class="hub-link" href="https://charlietrenorden.com/" target="_blank" rel="noopener noreferrer">Other Projects<span aria-hidden="true">&#8599;</span></a>
</header>

<nav class="country-picker" aria-label="Select country">
  <span class="picker-label">Select country</span>
  <ul class="chips">
    {% for c in all_countries %}
    <li><a class="chip" href="{{ c.slug }}/">{{ c.name }}</a></li>
    {% endfor %}
  </ul>
</nav>

<div class="welcome">
  <div class="welcome-icon">&#127963;</div>
  <h2>Explore history</h2>
  <p>Pick a country above to open its interactive timeline - eras, key events, and a map you can click through.</p>
</div>

<footer class="site-footer">{{ version }}</footer>
</body>
</html>
